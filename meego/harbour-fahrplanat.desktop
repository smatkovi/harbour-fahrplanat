[Desktop Entry]
Type=Application
Name=Fahrplan AT
Comment=Fahrplanauskunft für Österreich
# Der volle Pfad, nicht der Themenname: mit einem blossen "harbour-fahrplanat"
# findet die Startansicht das Symbol nicht und setzt ein rotes Ersatzquadrat
# hin -- auch dann, wenn die Datei unter hicolor und im meegotouch-Thema liegt.
Icon=/usr/share/icons/hicolor/80x80/apps/harbour-fahrplanat.png
Exec=/opt/harbour-fahrplanat/bin/harbour-fahrplanat
Terminal=false
Categories=Utility;
X-Osso-Type=application/x-executable
X-MeeGo-Logical-Id=Fahrplan AT
