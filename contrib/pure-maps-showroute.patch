+        onShowRoute: {
+            var route = null;
+            try {
+                route = JSON.parse(routeJson);
+            } catch (e) {
+                console.log("ShowRoute: invalid JSON: " + e);
+                return;
+            }
+            if (!route || !route.x || !route.y || route.x.length < 2 || route.x.length !== route.y.length) {
+                console.log("ShowRoute: route needs matching x and y arrays with at least two points");
+                return;
+            }
+            if (!route.mode) route.mode = "foot";
+            if (!route.provider) route.provider = "external";
+            if (!route.maneuvers) route.maneuvers = [];
+            if (!route.locations) route.locations = [];
+            app.navigator.setRoute(route);
+            map.autoCenter = false;
+            map.fitViewToRoute();
+            app.activate();
+        }
